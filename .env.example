# Environment variables for legal-decisions-rag
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Application Configuration
# Add any application-specific environment variables below

# Uncomment if `uv run`/`uv sync` warns "Failed to hardlink files; falling
# back to full copy" - happens when uv's cache and this project's .venv are
# on different filesystems/drives. Harmless either way, but this silences
# the warning (uv just copies instead of hardlinking, no functional
# difference, slightly more disk use).
# UV_LINK_MODE=copy
