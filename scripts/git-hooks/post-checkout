#!/usr/bin/env bash
# post-checkout hook: update the code-review-graph after checkout.
#
# Git passes three arguments:
#   $1 = previous HEAD ref
#   $2 = new HEAD ref
#   $3 = 1 if branch switch, 0 if file checkout
#
# Branch switch → full rebuild (structural changes across branches warrant it).
# File checkout → incremental update (only re-parse touched files).

prev_head="$1"
new_head="$2"
branch_flag="$3"

if [ "$branch_flag" = "1" ] && [ "$prev_head" != "$new_head" ]; then
    echo "[code-review-graph] Branch switch detected — rebuilding graph..."
    uv run code-review-graph build 2>/dev/null || true
else
    uv run code-review-graph update 2>/dev/null || true
fi
